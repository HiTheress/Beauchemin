# Beauchemin — protections Apache (requiert « AllowOverride All » ; sinon copier ces lignes dans le <Directory> du vhost).
Options -Indexes -MultiViews
DirectoryIndex index.php

# Seuls index.php, login.php, app/action/*.php et app/ajax/*.php sont des points d'entrée.
RedirectMatch 404 (^|/)(pages|inc|tests|tools|docs|database|deploy)(/|$)
RedirectMatch 404 (^|/)app/(classes|config|database)(/|$)
RedirectMatch 404 (^|/)app/(functions|init)\.php$
RedirectMatch 404 (^|/)\.[^/]

<FilesMatch "\.(sql|md|sh|log|bak|ini|lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
</IfModule>
